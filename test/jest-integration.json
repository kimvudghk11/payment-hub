{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "globalSetup": "<rootDir>/test/setup/integration-global-setup.ts",
  "testEnvironment": "node",
  "testTimeout": 30000
}
