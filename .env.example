# ---- 앱 ----
NODE_ENV=local
PORT=3000

# 이 배포가 담당하는 PG 환경 (TEST | LIVE). 배포 하나 = 환경 하나
PG_ENVIRONMENT=TEST

# ---- DB (docker compose 기본값과 일치) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=payment_hub
DB_PASSWORD=payment_hub
DB_DATABASE=payment_hub
DB_LOGGING=false

# ---- 통합 테스트 (npm run test:integration) ----
# 실행마다 DROP 후 재생성된다. 반드시 '_test'로 끝나야 한다
TEST_DB_DATABASE=payment_hub_test

# ---- 비밀값 암호화 (AES-256-GCM 키링) ----
# '<키ID>:<base64 32바이트>'를 쉼표로 나열. 키 교체 시 새 버전을 추가하고 ENCRYPTION_KEY_ID만 바꾼다 (이전 키는 복호화용으로 남김)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
ENCRYPTION_KEY_ID=v1

# ---- 관리자 API ----
# admin 레포 서버 전용 키의 SHA-256 해시(hex). 쉼표로 여러 개 → 무중단 교체
ADMIN_API_KEY_HASHES=

# ---- 토스페이먼츠 API ----
# 비워 두면 https://api.tosspayments.com. 테스트 결제도 같은 주소에 test_ 키로 호출한다
TOSS_API_BASE_URL=
# 승인 응답 대기(ms). 넘기면 결제를 UNKNOWN으로 두고 대사가 확정한다. 서비스의 confirm 호출 타임아웃은 이보다 길어야 한다
TOSS_API_TIMEOUT_MS=30000

# ---- hub → 서비스 웹훅 발송 ----
# false면 이 인스턴스는 발송하지 않는다 (발송 전용 인스턴스를 따로 둘 때)
WEBHOOK_DISPATCH_ENABLED=true
WEBHOOK_DISPATCH_INTERVAL_MS=1000
# 서비스 응답 대기(ms). 넘기면 실패로 보고 재시도
WEBHOOK_TIMEOUT_MS=10000

# ---- 대사 배치 (결과 불명 결제를 토스 조회로 확정) ----
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MS=60000

# ---- 주문 만료 배치 ----
ORDER_EXPIRY_ENABLED=true
ORDER_EXPIRY_INTERVAL_MS=60000

# ---- 이벤트 재조회 (GET /events) ----
# 발행 후 이 시간이 지난 이벤트만 준다 (늦게 커밋되는 이벤트를 건너뛰지 않게)
EVENT_FEED_LAG_MS=5000
